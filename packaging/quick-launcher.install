post_install() {
  cat <<'MSG'
==> Quick Launcher is installed.
==> Enable it once now with:
==>   gnome-extensions enable quick-launcher@julian.falcondev.de
==> Then log out and back in. If you skip this now, the next login offers an
==> "Enable Quick Launcher" button in a GNOME notification.
MSG
}

post_upgrade() {
  post_install
}
